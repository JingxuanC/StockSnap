.page { padding-bottom: 60rpx; }
.hero { background: linear-gradient(135deg,#16213e,#0f3460); padding: 50rpx 30rpx 40rpx; border-radius: 0 0 48rpx 48rpx; }
.title { font-size: 44rpx; font-weight: 800; color: #fff; }
.sub { font-size: 24rpx; color: rgba(255,255,255,0.6); margin-top: 8rpx; display: block; }
.section { margin: 30rpx 30rpx 0; }
.sh { font-size: 32rpx; font-weight: 600; color: #16213e; margin-bottom: 20rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card.locked { opacity: 0.5; }
.top { display: flex; align-items: flex-start; gap: 16rpx; }
.icon { font-size: 40rpx; }
.info { flex: 1; }
.name { font-size: 30rpx; font-weight: 600; color: #2d3436; display: block; }
.desc { font-size: 24rpx; color: #636e72; margin-top: 4rpx; display: block; }
.tier-badge { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: 600; white-space: nowrap; }
.tier-badge.free { background: #e8f8f5; color: #00b894; }
.tier-badge.pro { background: #fef9e7; color: #d4a017; }
.ex { margin-top: 20rpx; padding-top: 16rpx; border-top: 1px solid #f0f1f3; }
.ex-t { font-size: 22rpx; color: #636e72; }
.ex-q { display: inline-block; font-size: 22rpx; color: #16213e; background: #eaf2f8; padding: 6rpx 16rpx; border-radius: 12rpx; margin: 8rpx 8rpx 0 0; }
.tools { margin-top: 16rpx; font-size: 22rpx; color: #636e72; }
.lock { margin-top: 16rpx; font-size: 22rpx; color: #e17055; }
.upgrade { padding: 30rpx; }
.btn-accent { width: 100%; }
