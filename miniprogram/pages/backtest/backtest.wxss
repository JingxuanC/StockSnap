.page { padding:30rpx; padding-bottom:60rpx; }
.card { background:#fff; border-radius:20rpx; padding:30rpx; margin-bottom:20rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.title { font-size:32rpx; font-weight:600; color:#16213e; margin-bottom:20rpx; }
.picker { margin-bottom:20rpx; }
.input { background:#f5f6fa; border-radius:12rpx; padding:20rpx; font-size:30rpx; }
.strats { display:flex; flex-wrap:wrap; gap:16rpx; }
.s { padding:16rpx 28rpx; background:#f5f6fa; border-radius:12rpx; font-size:26rpx; color:#636e72; border:2rpx solid transparent; }
.s.act { background:#eaf2f8; color:#16213e; font-weight:600; border-color:#16213e; }
.row { display:flex; justify-content:space-between; align-items:center; }
.rinput { text-align:right; font-size:30rpx; }
.btn-accent { width:100%; margin-bottom:30rpx; }
.results { background:#fff; border-radius:20rpx; padding:30rpx; }
.grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20rpx; }
.gitem { text-align:center; padding:16rpx; }
.gv { display:block; font-size:36rpx; font-weight:700; color:#2d3436; }
.gl { display:block; font-size:22rpx; color:#636e72; margin-top:4rpx; }
