.page { min-height:100vh; padding-bottom:120rpx; }
.header { position:relative; margin-bottom:0; }
.hbg { position:absolute; top:0; left:0; right:0; height:260rpx; background:linear-gradient(135deg,#16213e,#0f3460); border-radius:0 0 48rpx 48rpx; }
.hcontent { position:relative; padding:30rpx; }
.top { display:flex; justify-content:space-between; align-items:flex-start; }
.name { font-size:44rpx; font-weight:700; color:#fff; display:block; }
.sym { font-size:26rpx; color:rgba(255,255,255,0.6); }
.score-wrap { flex-shrink:0; }
.score { width:120rpx; height:120rpx; border-radius:50%; border:6rpx solid; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(255,255,255,0.1); }
.sn { font-size:48rpx; font-weight:800; } .sl { font-size:20rpx; color:rgba(255,255,255,0.6); }
.rating-row { margin-top:24rpx; display:flex; align-items:flex-start; gap:16rpx; }
.rbadge { font-size:28rpx; font-weight:700; color:#fff; padding:6rpx 28rpx; border-radius:50rpx; white-space:nowrap; }
.rsummary { font-size:26rpx; color:rgba(255,255,255,0.85); line-height:1.5; flex:1; }
.tabs { background:#fff; border-bottom:1px solid #eee; position:sticky; top:0; z-index:10; }
.tlist { display:flex; padding:0 8rpx; white-space:nowrap; }
.t { padding:24rpx 28rpx; font-size:28rpx; color:#636e72; }
.t.act { color:#16213e; font-weight:600; border-bottom:4rpx solid #16213e; }
.content { padding:30rpx; line-height:1.8; font-size:28rpx; }
.content h2 { font-size:36rpx; font-weight:700; color:#16213e; margin:24rpx 0 16rpx; }
.content h3 { font-size:30rpx; font-weight:600; color:#2d3436; margin:16rpx 0 8rpx; }
.content strong { color:#16213e; }
.bottom { position:fixed; bottom:0; left:0; right:0; background:#fff; padding:20rpx 30rpx; box-shadow:0 -4rpx 20rpx rgba(0,0,0,0.06); z-index:50; }
.btn-primary { width:100%; }
/* 轮询等待状态 */
.polling { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:60rpx; }
.poll-card { text-align:center; width:100%; }
.poll-spinner { width:80rpx; height:80rpx; border:6rpx solid #dfe6e9; border-top-color:#16213e; border-radius:50%; margin:0 auto 40rpx; animation:spin 1s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.poll-title { display:block; font-size:36rpx; font-weight:700; color:#16213e; margin-bottom:16rpx; }
.poll-sub { display:block; font-size:26rpx; color:#636e72; margin-bottom:12rpx; }
.poll-time { display:block; font-size:24rpx; color:#b2bec3; margin-bottom:30rpx; }
.poll-bar { height:8rpx; background:#dfe6e9; border-radius:4rpx; overflow:hidden; }
.poll-fill { height:100%; background:linear-gradient(90deg,#16213e,#0f3460); border-radius:4rpx; transition:width 0.5s ease; }
