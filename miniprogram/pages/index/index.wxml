<view class="page">
  <view class="hero"><text class="logo">StockSnap</text><text class="sub">AI 股票分析助手</text></view>
  <view class="search-box">
    <text class="hint">💬 试试问：茅台估值合理吗？AAPL能不能买？帮我分析000001</text>
    <view class="row">
      <input class="query" placeholder="输入问题或股票代码..." value="{{query}}" bindinput="onQuery" bindconfirm="onChat" focus="{{focus}}" auto-height/>
    </view>
    <button class="btn-accent" bindtap="onChat" disabled="{{!query||loading}}">{{loading?'AI思考中...':'提问'}}</button>
    <view class="quick-asks">
      <view class="qa" wx:for="{{['分析茅台','NVDA能买吗','筛低估值芯片股','大盘怎么看']}}" wx:key="*this" data-q="{{item}}" bindtap="onQuickAsk">{{item}}</view>
    </view>
    <view class="quota" wx:if="{{quota}}"><text>本月剩余 {{quota.analysis_remaining}} 次</text></view>
  </view>
  <view class="section"><view class="title">历史</view>
    <block wx:if="{{history.length>0}}">
      <view class="item" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="onHistory">
        <view class="left"><text class="sym">{{item.symbol}}</text><text class="na">{{item.company_name}}</text><text class="dt">{{item.created_at}}</text></view>
        <view class="right"><view class="badge {{item.score>=70?'score-high':(item.score>=40?'score-mid':'score-low')}}"><text>{{item.score}}</text></view></view>
      </view>
    </block>
    <view wx:else class="empty"><text>暂无记录</text></view>
  </view>
</view>
