.page { min-height:100vh; padding-bottom:40rpx; }
.hero { background:linear-gradient(135deg,#16213e,#0f3460); padding:60rpx 40rpx 80rpx; text-align:center; border-radius:0 0 48rpx 48rpx; }
.logo { font-size:56rpx; font-weight:800; color:#fff; letter-spacing:4rpx; }
.sub { display:block; font-size:24rpx; color:rgba(255,255,255,0.6); margin-top:8rpx; }
.search-box { background:rgba(255,255,255,0.12); border-radius:24rpx; padding:30rpx; margin:-40rpx 30rpx 0; backdrop-filter:blur(10px); }
.row { display:flex; align-items:center; background:#fff; border-radius:16rpx; overflow:hidden; }
.pick { padding:20rpx 24rpx; background:#f0f1f3; font-size:28rpx; font-weight:500; color:#16213e; }
.code { flex:1; height:84rpx; padding:0 20rpx; font-size:32rpx; border:none; }
.btn-accent { width:100%; margin-top:20rpx; padding:28rpx; font-size:32rpx; }
.btn-accent[disabled] { opacity:0.5; }
.quota { margin-top:16rpx; text-align:center; }
.quota text { font-size:22rpx; color:rgba(255,255,255,0.8); }
.section { margin:30rpx 30rpx 0; }
.title { font-size:32rpx; font-weight:600; color:#16213e; margin-bottom:20rpx; }
.item { display:flex; justify-content:space-between; align-items:center; background:#fff; border-radius:16rpx; padding:24rpx; margin-bottom:16rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.sym { font-size:30rpx; font-weight:700; color:#16213e; }
.na { font-size:24rpx; color:#636e72; margin-left:16rpx; }
.dt { display:block; font-size:20rpx; color:#b2bec3; margin-top:6rpx; }
.badge { width:80rpx; height:80rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:700; color:#fff; }
.empty { text-align:center; padding:60rpx 0; color:#b2bec3; font-size:26rpx; }
